<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Budgeter.DetailPage"
             xmlns:vm="clr-namespace:Budgeter.ViewModels"
             x:DataType="vm:DetailViewModel"
             Padding="20">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0.5,3">
            <GradientStop Offset="0" Color="{AppThemeBinding Light={DynamicResource LightGradient1}, Dark={DynamicResource DarkGradient1}}" />
            <GradientStop Offset="1" Color="{AppThemeBinding Light={DynamicResource LightGradient2}, Dark={DynamicResource DarkGradient2}}" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="20">
        <Label 
            Text="{Binding Value}"
            FontSize="Title"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            HorizontalOptions="Center"
            Text="Return"
            Command="{Binding GoBackCommand}"/>
    </VerticalStackLayout>
</ContentPage>